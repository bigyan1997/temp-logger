
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_NAME=######
DB_USER=######
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Alert emails (reading almost due, missed, out of limit). Who receives them is set in the app under
# Settings, Alert emails. Leave EMAIL_HOST empty to only print them in the server window.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_FROM=

# The 4-weekly report PDFs are always saved in the project's report_exports folder.
# Optional extra copies (see docs/DEPLOYMENT.md step 11):
# a folder, e.g. one that Google Drive for desktop syncs to Google Drive:
REPORTS_EXPORT_DIR=
# or upload to a Google Shared Drive folder (Google Workspace only):
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=
