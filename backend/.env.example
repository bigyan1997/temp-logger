
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_NAME=######
DB_USER=######
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Alert emails (reading almost due, missed, out of limit). Who receives them is set in the app under
# Settings, Alert emails. Leave EMAIL_HOST empty to only print them in the server window.
# The address staff use to open the app (for the button in the email). Leave empty for no button.
APP_URL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# The sender shown in the inbox. With a name in front, mail shows the name instead of the bare address:
# EMAIL_FROM=Achieve Cafe Provisions <the-sending-address@gmail.com>
EMAIL_FROM=

# Where problems with the system itself are emailed: a failed nightly backup, a failed auto-deploy (tests, build,
# migration, app not coming back). Leave empty to send failed-backup alerts to the Alert emails list instead and
# to only log failed deploys. Check it works with: python manage.py send_alerts --test-system
SYSTEM_ALERT_EMAIL=

# Nightly database backup (docs/DEPLOYMENT.md step 10). The local folder scripts/backup.ps1 writes to.
# When set, the app emails the Alert emails list if a day has no backup in it (checked from 6 am).
# Keep it local (not the Drive folder), e.g. C:\Users\<you>\Desktop\Temp-Logger\backups
BACKUP_DIR=
# Second copy of each night's backup in a Google Drive for desktop folder, which uploads it,
# e.g. G:\My Drive\Temp Logger Backups. Leave empty for the local copy only.
BACKUP_DRIVE_DIR=

# The 4-weekly report PDFs are always saved in the project's report_exports folder.
# Optional extra copies (see docs/DEPLOYMENT.md step 12):
# a folder, e.g. one that Google Drive for desktop syncs, G:\My Drive\Temp Logger Reports
REPORTS_EXPORT_DIR=
# or upload to a Google Shared Drive folder (Google Workspace only):
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=
